pipeline {
    agent any

    environment {
        // Must match the Docker Hub username stored in the docker-hub-creds credential.
        DOCKERHUB_USERNAME = 'quan2k4'
        IMAGE_NAME         = "${DOCKERHUB_USERNAME}/social-network-backend"
        IMAGE_TAG          = "${BUILD_NUMBER}"
        DOCKER_BUILDKIT    = '1'

        DEPLOY_DIR         = '/opt/mochi-app'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '5'))
        timeout(time: 20, unit: 'MINUTES')
        timestamps()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo "Checked out ${env.GIT_BRANCH}"
            }
        }

        stage('Build Docker Image') {
            options {
                timeout(time: 30, unit: 'MINUTES')
            }
            steps {
                dir('backend') {
                    sh '''
                        set -eu
                        docker build --progress=plain \
                            -t "$IMAGE_NAME:$IMAGE_TAG" \
                            -t "$IMAGE_NAME:latest" \
                            .
                    '''
                }
                echo "Built Docker image: ${IMAGE_NAME}:${IMAGE_TAG}"
            }
        }

        stage('Push to Docker Hub') {
            options {
                timeout(time: 30, unit: 'MINUTES')
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'docker-hub-creds',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_TOKEN'
                )]) {
                    sh '''
                        set -eu

                        if [ "$DOCKER_USER" != "$DOCKERHUB_USERNAME" ]; then
                            echo "Docker Hub credential user '$DOCKER_USER' does not match image owner '$DOCKERHUB_USERNAME'." >&2
                            exit 1
                        fi

                        echo "$DOCKER_TOKEN" | docker login -u "$DOCKER_USER" --password-stdin
                        docker push "$IMAGE_NAME:$IMAGE_TAG"
                        docker push "$IMAGE_NAME:latest"
                    '''
                }
            }
        }

        stage('Deploy') {
            options {
                timeout(time: 30, unit: 'MINUTES')
            }
            steps {
                withCredentials([
                    file(credentialsId: 'prod-env-file', variable: 'ENV_FILE')
                ]) {
                    sh '''
                        set -eu

                        mkdir -p "$DEPLOY_DIR"
                        cp "$ENV_FILE" "$DEPLOY_DIR/.env"
                        chmod 600 "$DEPLOY_DIR/.env"
                        cp backend/docker-compose.yml "$DEPLOY_DIR/docker-compose.yml"

                        if ! grep -Eq '^(FIREBASE_SERVICE_ACCOUNT_BASE64|FIREBASE_SERVICE_ACCOUNT_JSON)=.+' "$DEPLOY_DIR/.env"; then
                            echo "Missing Firebase service account config in production env file." >&2
                            echo "Set FIREBASE_SERVICE_ACCOUNT_BASE64 or FIREBASE_SERVICE_ACCOUNT_JSON." >&2
                            exit 1
                        fi

                        export DOCKERHUB_USERNAME IMAGE_TAG
                        docker compose -f "$DEPLOY_DIR/docker-compose.yml" pull backend
                        docker compose -f "$DEPLOY_DIR/docker-compose.yml" up -d --force-recreate backend
                        docker image prune -f
                    '''
                }
            }
        }
    }

    post {
        always {
            sh '''
                docker rmi "$IMAGE_NAME:$IMAGE_TAG" || true
                docker logout || true
            '''
            cleanWs()
        }
    }
}
