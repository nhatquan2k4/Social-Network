PORT=3001
NODE_ENV=production
CORS_ORIGIN=https://your-frontend-domain.com
SWAGGER_SERVER_URL=https://api.your-domain.com

ACCESS_TOKEN_SECRET=replace-with-very-long-random-secret
MONGODB_CONNECTIONSTRING=mongodb+srv://<username>:<password>@<cluster>/<database>

MINIO_STRICT_STARTUP=true
MINIO_ENDPOINT=minio.your-domain.com
MINIO_PORT=9000
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key
MINIO_BUCKET_POSTS=social-posts
MINIO_BUCKET_MESSAGES=social-messages
MINIO_BUCKET_AVATARS=social-avatars
MINIO_PUBLIC_BASE_URL=https://cdn.your-domain.com

MEDIA_MAX_FILE_SIZE=5242880
MEDIA_MAX_FILES=10
MEDIA_POST_MAX_DIMENSION=1920
MEDIA_MESSAGE_MAX_DIMENSION=1280
MEDIA_AVATAR_MAX_DIMENSION=512
MEDIA_POST_QUALITY=82
MEDIA_MESSAGE_QUALITY=78
MEDIA_AVATAR_QUALITY=80
MEDIA_MESSAGE_REQUIRE_CONVERSATION_ID=true

MAIL_FROM=Social Network <no-reply@your-domain.com>
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
SMTP_SECURE=false
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=900
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_REDIRECT_URL=https://your-frontend-domain.com/verify-email
